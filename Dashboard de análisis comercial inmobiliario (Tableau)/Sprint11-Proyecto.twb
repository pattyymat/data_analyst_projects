    <worksheet name='YoY%'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='10'>YoY %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hecho_ventas_propiedades+' name='federated.0forjjb1a52b7u1dg7x6g0jxvtyk' />
          </datasources>
          <datasource-dependencies datasource='federated.0forjjb1a52b7u1dg7x6g0jxvtyk'>
            <column caption='YoY %' datatype='real' name='[Calculation_0585523473756174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_0585523481366544])- SUM([Calculation_0585523484053521]))/SUM([Calculation_0585523484053521])' />
            </column>
            <column caption='Ingreso 2024' datatype='real' name='[Calculation_0585523481366544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([fecha_venta]) = { MAX(YEAR([fecha_venta])) } THEN&#13;&#10;    [precio_venta]&#13;&#10;END' />
            </column>
            <column caption='Ingreso 2023' datatype='real' name='[Calculation_0585523484053521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([fecha_venta]) = { MAX(YEAR([fecha_venta])) } - 1 THEN&#13;&#10;    [precio_venta]&#13;&#10;END' />
            </column>
            <column caption='Estado YoY' datatype='string' name='[Calculation_0585523492233235]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0585523473756174] &gt; 0 THEN &quot;▲&quot;&#13;&#10;ELSEIF [Calculation_0585523473756174] &lt; 0 THEN &quot;▼&quot;&#13;&#10;ELSE &quot;▬&quot;&#13;&#10;END' />
            </column>
            <column caption='Canal Venta' datatype='string' name='[canal_venta]' role='dimension' type='nominal' />
            <column caption='Ciudad' datatype='string' name='[ciudad]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
