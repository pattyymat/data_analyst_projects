      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0forjjb1a52b7u1dg7x6g0jxvtyk].[sum:precio_venta:qk]&quot;' value='Ingresos año actual' />
          <alias key='&quot;[federated.0forjjb1a52b7u1dg7x6g0jxvtyk].[usr:Calculation_0585523049807873:qk]&quot;' value='Cant. Ventas' />
        </aliases>
      </column>
      <column caption='Ingreso Total' datatype='real' name='[Calculation_0585523049607168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([precio_venta])' />
      </column>
      <column caption='Cantidad de Ventas' datatype='integer' name='[Calculation_0585523049807873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id_venta])' />
      </column>
      <column caption='Ticket Promedio' datatype='real' name='[Calculation_0585523051171842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0585523049607168]/[Calculation_0585523049807873]' />
      </column>
      <column caption='Comisión Total' datatype='real' name='[Calculation_0585523052003331]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([monto_comision])' />
      </column>
      <column caption='Participación de Ingresos' datatype='real' default-format='p0.00%' name='[Calculation_0585523098255365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([precio_venta])/SUM({ FIXED : SUM([precio_venta]) })' />
      </column>
      <column caption='Ingresos año anterior' datatype='real' name='[Calculation_0585523110322183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([precio_venta]), -12)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Primera compra x cliente' datatype='date' name='[Calculation_0585523136450568]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [id_cliente]: MIN([fecha_venta]) }' />
      </column>
      <column caption='Mes Cohorte' datatype='datetime' name='[Calculation_0585523137138697]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Calculation_0585523136450568])' />
      </column>
      <column caption='Mes Venta' datatype='integer' name='[Calculation_0585523137953802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Calculation_0585523136450568],[fecha_venta])' />
      </column>
      <column caption='YoY %' datatype='real' name='[Calculation_0585523473756174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0585523481366544])- SUM([Calculation_0585523484053521]))/SUM([Calculation_0585523484053521])' />
      </column>
      <column caption='Ingreso 2024' datatype='real' name='[Calculation_0585523481366544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([fecha_venta]) = { MAX(YEAR([fecha_venta])) } THEN&#13;&#10;    [precio_venta]&#13;&#10;END' />
      </column>
      <column caption='Ingreso 2023' datatype='real' name='[Calculation_0585523484053521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([fecha_venta]) = { MAX(YEAR([fecha_venta])) } - 1 THEN&#13;&#10;    [precio_venta]&#13;&#10;END' />
      </column>
      <column caption='Estado YoY' datatype='string' name='[Calculation_0585523492233235]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0585523473756174] &gt; 0 THEN &quot;▲&quot;&#13;&#10;ELSEIF [Calculation_0585523473756174] &lt; 0 THEN &quot;▼&quot;&#13;&#10;ELSE &quot;▬&quot;&#13;&#10;END' />
      </column>
